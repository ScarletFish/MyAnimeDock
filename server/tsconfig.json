{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["**/*.js", "**/*.ts"],
  "exclude": ["node_modules", "dist", "__tests__", "logger.js"]
}