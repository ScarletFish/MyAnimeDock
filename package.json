{
  "name": "anime-manager",
  "version": "1.0.0",
  "description": "Local anime management library with Bangumi metadata and mpv integration",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --target node18-win-x64 --output dist/anime-manager.exe"
