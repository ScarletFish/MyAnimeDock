{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyAnimeDock",
  "identifier": "MyAnimeDock",
  "build": {
    "devUrl": "http://localhost:3456",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MyAnimeDock",
        "width": 1920,
        "height": 1080,
        "minWidth": 800,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "server"
    ],
    "resources": {
      "../frontend/dist": "frontend/dist",
      "sidecar-modules/prisma-engine": "sidecar-modules/prisma-engine",
      "sidecar-modules/@prisma/client": "sidecar-modules/@prisma/client",
      "sidecar-modules/@prisma/debug": "sidecar-modules/@prisma/debug",
      "sidecar-modules/@prisma/engines-version": "sidecar-modules/@prisma/engines-version",
      "sidecar-modules/@prisma/get-platform": "sidecar-modules/@prisma/get-platform",
      "sidecar-modules/ffmpeg.exe": "sidecar-modules/ffmpeg.exe"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "compression": "zlib",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "shell": {
      "open": true
    }
  }
}