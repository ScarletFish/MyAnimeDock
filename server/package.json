{
  "name": "anime-manager-server",
  "version": "1.0.0",
  "description": "MyAnimeDock backend server",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --target node18-win-x64 --output ../src-tauri/resources/server.exe",
    "test": "node --test __tests__/*.test.js",
    "test:routes": "node --test __tests__/routes/*.test.js"
  },
  "pkg": {
    "assets": [
      "../public/**/*"
    ],
    "scripts": [
      "scanner.js",
      "mpv-controller.js",
      "scrapers/**/*.js"
    ],
    "targets": ["node18-win-x64"]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "anitomy": "^0.0.35",
    "ffmpeg-static": "^5.3.0",
    "pinyin": "^4.0.0"
  }
}