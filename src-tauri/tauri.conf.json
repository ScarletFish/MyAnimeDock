{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyAnimeDocker",
  "version": "1.0.0",
  "identifier": "com.myanimedocker.app",
  "build": {
    "beforeBuildCommand": "npm run build:server",
    "devUrl": "http://localhost:3456",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "MyAnimeDocker",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "server.exe"
    ],
    "resources": [
      "../server/node_modules/**/*",
      "../server/scanner.js",
      "../server/mpv-controller.js",
      "../server/scrapers/**/*",
      "../server/package.json",
      "../server/package-lock.json"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "shell": {
      "open": true
    }
  }
}