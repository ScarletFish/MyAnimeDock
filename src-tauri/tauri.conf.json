{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyAnimeDock",
  "identifier": "MyAnimeDock",
  "build": {
    "devUrl": "http://localhost:3456",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "server"
    ],
    "resources": {
      "../frontend/dist": "frontend/dist",
      "sidecar-modules/better-sqlite3": "sidecar-modules/better-sqlite3",
      "sidecar-modules/bindings": "sidecar-modules/bindings",
      "sidecar-modules/file-uri-to-path": "sidecar-modules/file-uri-to-path",
      "sidecar-modules/ffmpeg.exe": "sidecar-modules/ffmpeg.exe"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "compression": "zlib",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "shell": {
      "open": true
    }
  }
}